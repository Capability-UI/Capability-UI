{
  "name": "@capability-ui/core",
  "version": "0.2.0",
  "description": "Agent-neutral capability, policy, projection, and guarded execution core for generative interfaces.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "cup": "./dist/src/bin/cup.js"
  },
  "files": [
    "dist/src",
    "sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "examples:install": "npm install --prefix examples",
    "examples:test": "npm test --prefix examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Capability-UI/Capability-UI.git"
  },
  "homepage": "https://github.com/Capability-UI/Capability-UI#readme",
  "bugs": {
    "url": "https://github.com/Capability-UI/Capability-UI/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "keywords": [
    "authorization",
    "capabilities",
    "generative-ui",
    "cli",
    "policy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
